{
    "info": {
        "name": "Restaurant Web App API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api",
            "type": "string"
        },
        {
            "key": "access_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123!\",\n  \"phone_number\": \"123456789\",\n  \"address\": \"123 St\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Login (Get JWT)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/token/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "token",
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Menu & Categories",
            "item": [
                {
                    "name": "List Categories",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/categories/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "categories",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "List Menu Items",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/menu/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "menu",
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Orders",
            "item": [
                {
                    "name": "List Orders",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/orders/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "orders",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"delivery_type\": \"pickup\",\n  \"payment_method\": \"cash_on_delivery\",\n  \"items\": [\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 2,\n      \"special_notes\": \"No spicy\"\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/orders/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "orders",
                                ""
                            ]
                        }
                    }
                }
            ]
        }
    ]
}